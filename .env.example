# ─────────────────────────────────────────────────────────
# AIOps Server Monitor — Environment Variables
# Copy to .env and fill in your values.
# These override the defaults defined in config.py.
# ─────────────────────────────────────────────────────────

# Language: "en" or "ko"
AIOPS_LANG=en

# LLM provider: ollama (local, default) | openai | gemini
LLM_PROVIDER=ollama
# Prompts include process lists and logs. Non-local endpoints are refused
# unless this is true.
LLM_ALLOW_EXTERNAL=false

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b

# OpenAI-compatible server (llama.cpp, vLLM, LM Studio, or a cloud API)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_MODEL=
OPENAI_API_KEY=

# Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Discord — use separate webhooks for alerts and daily reports
DISCORD_ALERT_WEBHOOK=https://discordapp.com/api/webhooks/...
DISCORD_REPORT_WEBHOOK=https://discordapp.com/api/webhooks/...

# Log file path
LOG_FILE=/home/user/diagnostics.csv

# Prometheus exporter port
PROMETHEUS_PORT=8000
