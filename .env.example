# ─────────────────────────────────────────────────────────
# AIOps Server Monitor — Environment Variables
# Copy to .env and fill in your values.
# These override the defaults defined in config.py.
# ─────────────────────────────────────────────────────────

# Language: "en" or "ko"
AIOPS_LANG=en

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b

# Discord — use separate webhooks for alerts and daily reports
DISCORD_ALERT_WEBHOOK=https://discordapp.com/api/webhooks/...
DISCORD_REPORT_WEBHOOK=https://discordapp.com/api/webhooks/...

# Log file path
LOG_FILE=/home/user/diagnostics.csv

# Prometheus exporter port
PROMETHEUS_PORT=8000

# Prometheus server to query for container growth (anchor selection).
# Empty = disabled. On a K3s node the ClusterIP is reachable directly:
#   kubectl get svc prometheus-server -n monitoring -o jsonpath='{.spec.clusterIP}'
PROMETHEUS_QUERY_URL=
ANCHOR_CHANGE_WINDOW=30m
ANCHOR_MIN_MEM_GROWTH_MB=100
ANCHOR_MIN_CPU_GROWTH_CORES=0.2
